 "doctype": "Print Format",
 "font_size": 12,
 "html": "\n<div class=\"print-format-receipt\" style=\"font-family: Arial, sans-serif; padding: 30px; max-width: 780px; margin: 0 auto; border: 2px solid #333;\">\n\n    {% set company_doc = frappe.get_cached_doc(\"Company\", doc.company) %}\n    {% set logo_url = company_doc.get(\"custom_voucher_print_logo\") or company_doc.get(\"company_logo\") %}\n\n    <!-- Header -->\n    <table style=\"width:100%; border-bottom: 2px solid #333; padding-bottom: 15px; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"width:80px; vertical-align:top;\">\n                {% if logo_url %}\n                <img src=\"{{ logo_url }}\" style=\"max-width:70px; max-height:70px;\">\n                {% endif %}\n            </td>\n            <td style=\"text-align:center; vertical-align:middle;\">\n                <h2 style=\"margin:0; font-size:22px; letter-spacing:1px;\">{{ company_doc.company_name }}</h2>\n                {% if company_doc.email %}<div style=\"font-size:11px;\">{{ company_doc.email }}</div>{% endif %}\n                {% if company_doc.phone_no %}<div style=\"font-size:11px;\">{{ company_doc.phone_no }}</div>{% endif %}\n            </td>\n            <td style=\"width:80px;\"></td>\n        </tr>\n    </table>\n\n    <h3 style=\"text-align:center; margin: 10px 0 25px 0; letter-spacing:3px; border: 1px solid #333; padding: 6px; display:inline-block; width:200px; margin-left: calc(50% - 100px);\">FEE RECEIPT</h3>\n\n    <!-- Receipt meta -->\n    <table style=\"width:100%; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"padding:4px 0;\"><b>Receipt No:</b> {{ doc.name }}</td>\n            <td style=\"text-align:right; padding:4px 0;\"><b>Date:</b> {{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}</td>\n        </tr>\n    </table>\n\n    <!-- Student details -->\n    <table style=\"width:100%; margin-bottom: 15px; border-collapse:collapse;\">\n        <tr>\n            <td style=\"padding:8px 0; width: 35%;\"><b>Received from:</b></td>\n            <td style=\"padding:8px 0; font-size:16px;\">{{ doc.student_name or doc.ex_student }}</td>\n        </tr>\n        {% set student = frappe.get_cached_doc(\"Ex Student\", doc.ex_student) %}\n        {% if student.course or student.batch_year %}\n        <tr>\n            <td style=\"padding:4px 0;\"><b>Course / Batch:</b></td>\n            <td style=\"padding:4px 0;\">\n                {{ student.course or \"-\" }}\n                {% if student.batch_year %} ({{ student.batch_year }}){% endif %}\n            </td>\n        </tr>\n        {% endif %}\n        {% if student.father_name %}\n        <tr>\n            <td style=\"padding:4px 0;\"><b>Father Name:</b></td>\n            <td style=\"padding:4px 0;\">{{ student.father_name }}</td>\n        </tr>\n        {% endif %}\n    </table>\n\n    <!-- Amount -->\n    <table style=\"width:100%; background:#f8f9fa; padding: 15px; margin: 15px 0; border: 1px solid #ccc;\">\n        <tr>\n            <td style=\"padding:10px; width:35%;\"><b>Amount Received:</b></td>\n            <td style=\"padding:10px; font-size:20px; font-weight:bold; color:#2c5282;\">\n                {{ frappe.utils.fmt_money(doc.amount, currency=company_doc.default_currency) }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"padding:10px;\"><b>In Words:</b></td>\n            <td style=\"padding:10px; font-style:italic; text-transform:capitalize;\">\n                {{ frappe.utils.money_in_words(doc.amount, company_doc.default_currency) }}\n            </td>\n        </tr>\n    </table>\n\n    <!-- Payment details -->\n    <table style=\"width:100%; margin-bottom: 15px;\">\n        <tr>\n            <td style=\"padding:4px 0; width:35%;\"><b>Payment Method:</b></td>\n            <td style=\"padding:4px 0;\">{{ doc.mode_of_payment }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding:4px 0;\"><b>Received In:</b></td>\n            <td style=\"padding:4px 0;\">{{ doc.received_in_account }}</td>\n        </tr>\n        {% if doc.reference_no %}\n        <tr>\n            <td style=\"padding:4px 0;\"><b>Reference:</b></td>\n            <td style=\"padding:4px 0;\">\n                {{ doc.reference_no }}\n                {% if doc.reference_date %} &bull; {{ frappe.utils.formatdate(doc.reference_date, \"dd-MM-yyyy\") }}{% endif %}\n            </td>\n        </tr>\n        {% endif %}\n    </table>\n\n    {% if doc.remarks %}\n    <div style=\"margin: 15px 0; padding: 10px; background:#fffbe5; border-left: 4px solid #eab308;\">\n        <b>Remarks:</b> {{ doc.remarks }}\n    </div>\n    {% endif %}\n\n    <!-- Outstanding breakdown -->\n    <table style=\"width:100%; margin-top: 20px; border-top:1px dashed #999; padding-top:10px;\">\n        <tr>\n            <td style=\"padding:4px 0; font-size:11px; color:#666;\">Outstanding before this receipt:</td>\n            <td style=\"padding:4px 0; font-size:11px; color:#666; text-align:right;\">\n                {{ frappe.utils.fmt_money(doc.outstanding_before, currency=company_doc.default_currency) }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"padding:4px 0; font-size:11px; color:#666;\">Outstanding after this receipt:</td>\n            <td style=\"padding:4px 0; font-size:11px; color:#666; text-align:right;\">\n                {{ frappe.utils.fmt_money(doc.outstanding_after, currency=company_doc.default_currency) }}\n            </td>\n        </tr>\n    </table>\n\n    <!-- Signature -->\n    <div style=\"margin-top: 60px; text-align:right;\">\n        <div style=\"display:inline-block; border-top: 1px solid #333; padding-top: 6px; min-width: 220px; text-align:center;\">\n            Authorised Signatory\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div style=\"margin-top: 30px; text-align:center; font-size:10px; color:#888; border-top: 1px solid #eee; padding-top: 10px;\">\n        {% if company_doc.get(\"custom_voucher_footer_note\") %}\n            {{ company_doc.custom_voucher_footer_note }}<br>\n        {% endif %}\n        This is a computer-generated receipt.\n    </div>\n</div>\n",
